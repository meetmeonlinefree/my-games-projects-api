<script>
(()=>{'use strict';
const BASE='https://raw.githubusercontent.com/meetmeonlinefree/my-games-projects-api/main/v1/';
const dict={
ru:{navGames:'Игры',navProjects:'Проекты',navAbout:'Об авторе',eyebrow:'Мир творчества и кода',hero1:'Играй.',hero2:'Исследуй.',hero3:'Создавай.',intro:'Добро пожаловать в коллекцию игр и веб-проектов молодого разработчика. Каждая новая идея превращается здесь в настоящий проект.',explore:'🎮 Смотреть игры',seeProjects:'⌘ Смотреть проекты',gamesTitle:'🎮 Мои игры',gamesSub:'Играй прямо в браузере — без установки.',projectsTitle:'💻 Мои проекты',projectsSub:'Сайты, приложения и творческие эксперименты.',loading:'Загружаем коллекцию…',aboutTitle:'Создано с любопытством',aboutText:'Это пространство начинающего разработчика, который учится создавать игры и веб-приложения с помощью HTML, CSS и JavaScript. Здесь собраны его работы и новые идеи.',github:'Посмотреть коллекцию на GitHub ↗',privacy:'Политика конфиденциальности',back:'Наверх ↑',openGame:'Играть ↗',openProject:'Открыть проект ↗',emptyGames:'Пока нет опубликованных игр. Скоро здесь появятся новые!',emptyProjects:'Пока нет опубликованных проектов.',loadError:'Не удалось загрузить данные. Попробуйте обновить страницу.',games:'игр',projects:'проектов',game:'Игра',project:'Проект'},
tg:{navGames:'Бозиҳо',navProjects:'Лоиҳаҳо',navAbout:'Дар бораи муаллиф',eyebrow:'Ҷаҳони эҷод ва барномасозӣ',hero1:'Бозӣ кун.',hero2:'Кашф кун.',hero3:'Эҷод кун.',intro:'Ба маҷмӯаи бозиҳо ва лоиҳаҳои вебии барномасози ҷавон хуш омадед. Дар ин ҷо ҳар як идея ба лоиҳаи воқеӣ табдил меёбад.',explore:'🎮 Дидани бозиҳо',seeProjects:'⌘ Дидани лоиҳаҳо',gamesTitle:'🎮 Бозиҳои ман',gamesSub:'Бевосита дар браузер бозӣ кун — бе насб.',projectsTitle:'💻 Лоиҳаҳои ман',projectsSub:'Сомонаҳо, барномаҳо ва таҷрибаҳои эҷодӣ.',loading:'Маҷмӯа бор шуда истодааст…',aboutTitle:'Бо шавқу ҳавас сохта шудааст',aboutText:'Ин фазои барномасози навкор аст, ки бо HTML, CSS ва JavaScript сохтани бозиҳо ва веб-барномаҳоро меомӯзад. Дар ин ҷо корҳои ӯ ҷамъ оварда шудаанд.',github:'Дидани маҷмӯа дар GitHub ↗',privacy:'Сиёсати махфият',back:'Ба боло ↑',openGame:'Бозӣ кардан ↗',openProject:'Кушодани лоиҳа ↗',emptyGames:'Ҳоло бозии нашршуда нест. Ба зудӣ бозиҳои нав пайдо мешаванд!',emptyProjects:'Ҳоло лоиҳаи нашршуда нест.',loadError:'Боркунии маълумот муяссар нашуд. Саҳифаро нав кунед.',games:'бозӣ',projects:'лоиҳа',game:'Бозӣ',project:'Лоиҳа'},
en:{navGames:'Games',navProjects:'Projects',navAbout:'About',eyebrow:'A world of creativity and code',hero1:'Play.',hero2:'Explore.',hero3:'Create.',intro:'Welcome to a growing collection of games and web projects by a young developer. Every new idea becomes something real.',explore:'🎮 Explore games',seeProjects:'⌘ View projects',gamesTitle:'🎮 My Games',gamesSub:'Play right in your browser — no installation needed.',projectsTitle:'💻 My Projects',projectsSub:'Websites, apps and creative experiments.',loading:'Loading collection…',aboutTitle:'Made with curiosity',aboutText:'A space for a young developer learning to build games and web apps with HTML, CSS and JavaScript. Explore the projects and follow the creative journey.',github:'View collection on GitHub ↗',privacy:'Privacy Policy',back:'Back to top ↑',openGame:'Play now ↗',openProject:'Open project ↗',emptyGames:'No published games yet. New ones are coming soon!',emptyProjects:'No published projects yet.',loadError:'Could not load data. Please refresh the page.',games:'games',projects:'projects',game:'Game',project:'Project'}};
let language='ru';try{const saved=localStorage.getItem('mgp-language');if(dict[saved])language=saved;else{const browser=navigator.language.toLowerCase();if(browser.startsWith('tg'))language='tg';else if(browser.startsWith('en'))language='en';}}catch(e){}
const data={games:null,projects:null};const t=k=>dict[language][k]||k;
function localized(v){if(typeof v==='string')return v;if(v&&typeof v==='object')return v[language]||v.ru||v.en||v.tg||'';return ''}
function validUrl(url){try{const u=new URL(url);return u.protocol==='https:'?u.href:null}catch{return null}}
function el(tag,cls,txt){const e=document.createElement(tag);if(cls)e.className=cls;if(txt!==undefined)e.textContent=txt;return e}
function render(kind){const target=document.getElementById(kind+'List');target.replaceChildren();const entries=data[kind];const count=document.getElementById(kind+'Count');count.textContent=Array.isArray(entries)?entries.filter(x=>x&&x.status!=='draft'&&x.status!=='hidden').length+' '+t(kind):'—';if(!Array.isArray(entries)){target.append(el('div','empty',t('loadError')));return}const shown=entries.filter(x=>x&&x.status!=='draft'&&x.status!=='hidden');if(!shown.length){target.append(el('div','empty',t(kind==='games'?'emptyGames':'emptyProjects')));return}for(const item of shown){const card=el('article','card');const thumb=el('div','thumb');const imgurl=validUrl(item.image);if(imgurl){const img=el('img');img.src=imgurl;img.alt=localized(item.title)||'';img.loading='lazy';img.referrerPolicy='no-referrer';img.onerror=()=>{thumb.replaceChildren(el('span','emoji',kind==='games'?'🎮':'💻'))};thumb.append(img)}else thumb.append(el('span','emoji',kind==='games'?'🎮':'💻'));card.append(thumb);const body=el('div','cardbody');body.append(el('span','tag',t(kind==='games'?'game':'project')));body.append(el('h3','',localized(item.title)||'Untitled'));body.append(el('p','',localized(item.description)));const link=validUrl(item.url);if(link){const a=el('a','play',t(kind==='games'?'openGame':'openProject'));a.href=link;a.target='_blank';a.rel='noopener noreferrer';body.append(a)}card.append(body);target.append(card)}}
function translate(){document.documentElement.lang=language;document.querySelectorAll('[data-i18n]').forEach(n=>{n.textContent=t(n.dataset.i18n)});document.querySelectorAll('[data-lang]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.lang===language)));for(const k of ['games','projects']){if(data[k])render(k)}}
document.querySelectorAll('[data-lang]').forEach(b=>b.addEventListener('click',()=>{language=b.dataset.lang;try{localStorage.setItem('mgp-language',language)}catch(e){}translate()}));document.getElementById('year').textContent=new Date().getFullYear();translate();
async function load(kind){try{const res=await fetch(BASE+kind+'.json',{cache:'no-cache'});if(!res.ok)throw Error('HTTP '+res.status);const json=await res.json();if(!Array.isArray(json[kind]))throw Error('Invalid '+kind+' array');data[kind]=json[kind]}catch(e){console.warn('Could not load '+kind,e);data[kind]=null}render(kind)}Promise.all([load('games'),load('projects')]);
})();
</script>
