pan{background:linear-gradient(90deg,#7dc6ff,#a89cff);background-clip:text;color:transparent}.lead{font-size:18px;line-height:1.8;color:var(--muted);max-width:590px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:15px 23px;border-radius:14px;font-weight:800;border:1px solid var(--line);transition:transform .2s,background .2s}.btn:hover{transform:translateY(-2px)}.primary{background:linear-gradient(135deg,#348bff,#6555ed);border:0;box-shadow:0 12px 35px #2669ef55}.secondary{background:#ffffff10}.art{min-height:370px;display:grid;place-items:center;position:relative}.orb{position:absolute;width:min(100%,410px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,#438bff60 0%,#653be433 48%,transparent 70%);filter:blur(5px)}.console{position:relative;width:300px;height:265px;background:linear-gradient(145deg,#305be4,#7546d9);border:1px solid #ffffff50;border-radius:46px;box-shadow:0 38px 95px #0009,inset 0 3px 12px #ffffff44;transform:rotate(-9deg);display:grid;place-items:center}.console svg{width:210px;filter:drop-shadow(0 12px 10px #13226d66)}.float{position:absolute;display:grid;place-items:center;width:62px;height:62px;border:1px solid #ffffff3d;border-radius:20px;background:#1c346ccc;box-shadow:0 15px 35px #0006;font-size:29px}.f1{top:5%;right:2%}.f2{bottom:5%;left:0}.f3{bottom:7%;right:4%}.section{padding:70px 0}.sectionhead{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:28px}.section h2{font-size:clamp(28px,4vw,39px);letter-spacing:-1px;margin:0 0 10px}.sub{color:var(--muted);line-height:1.7;margin:0}.pill{border:1px solid var(--line);border-radius:30px;padding:8px 14px;color:#c3d6ff;font-size:13px}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.card{background:linear-gradient(160deg,#182a54,#0e1b39);border:1px solid var(--line);border-radius:23px;overflow:hidden;transition:transform .2s,border-color .2s}.card:hover{transform:translateY(-5px);border-color:#548dff99}.thumb{height:185px;background:linear-gradient(135deg,#293e85,#1b8bc3);display:grid;place-items:center;overflow:hidden}.thumb img{width:100%;height:100%;object-fit:cover}.thumb .emoji{font-size:68px}.cardbody{padding:22px}.tag{font-size:11px;letter-spacing:1px;color:#88b7ff;font-weight:900;text-transform:uppercase}.card h3{font-size:21px;margin:9px 0}.card p{color:var(--muted);font-size:14px;line-height:1.6;min-height:46px}.play{display:inline-flex;align-items:center;gap:7px;color:#8bc9ff;font-weight:800;font-size:14px;margin-top:12px}.empty{grid-column:1/-1;padding:40px;text-align:center;border:1px dashed #6383bd88;border-radius:20px;color:var(--muted);line-height:1.7}.about{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center;background:linear-gradient(120deg,#152f69,#1b2351);border:1px solid #6b88d044;border-radius:30px;padding:40px}.abouticon{font-size:90px;text-align:center}.about p{color:#d0dcf5;line-height:1.8}.footer{margin-top:80px;border-top:1px solid var(--line);padding:28px 0;color:var(--muted);font-size:13px}.footrow{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.footrow div{display:flex;gap:20px}.status{color:var(--muted);font-size:13px}.sr{position:absolute;clip:rect(0,0,0,0);width:1px;height:1px;overflow:hidden}@media(max-width:820px){.hero{grid-template-columns:1fr;padding:68px 0 45px;gap:25px}.art{min-height:310px}.console{width:240px;height:210px}.console svg{width:170px}.cards{grid-template-columns:repeat(2,1fr)}.navlinks{display:none}.about{grid-template-columns:1fr}.abouticon{font-size:65px}}@media(max-width:540px){.wrap{padding:0 18px}.nav{height:70px}.brand{font-size:13px}.mark{width:36px;height:36px}.lang button{padding:7px}.hero{padding-top:54px}h1{letter-spacing:-2px}.lead{font-size:16px}.art{min-height:275px}.console{width:210px;height:195px;border-radius:32px}.console svg{width:155px}.float{width:48px;height:48px;font-size:2